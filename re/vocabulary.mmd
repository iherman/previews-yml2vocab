classDiagram
    direction TB
    accTitle: Recognized Entities Vocabulary
    accDescr {
        RDFS vocabulary used by the Recognized Entities specification, represented as a Mermaid diagram.
    }
    class RecognizedEntity {
        registration : URL
    }
    class RecognizedAction {
        action : string
        recognizedBy : URL
        validFrom : dateTime
        validUntil : dateTime
    }
    class RecognizedEntityCredential {
        legalName
        image : URL
        url : URL
        sameAs : URL
        description
        digestMultibase
        validFrom : dateTime
        validUntil : dateTime
        name
        issuer
        credentialSubject
    }
    class RecognizedIssuer {}
    class CredentialValidator {}
    class ExternalEntityList {}


    RecognizedEntityCredential --|> VerifiableCredential : subClassOf

    RecognizedEntity --> RecognizedAction : recognizedTo
    RecognizedEntity --> ExternalEntityList : recognizedIn
    RecognizedEntity --> RecognizedEntityCredential : recognizedIn
    RecognizedAction --> CredentialValidator : credentialValidator
    RecognizedIssuer --> ExternalEntityList : recognizedIn
    RecognizedIssuer --> RecognizedEntityCredential : recognizedIn

