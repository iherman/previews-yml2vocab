
%%{
     init: {
        "theme" : "redux",
        "layout" : "dagree",
        "look" : "neo",
        "class": {
            "hideEmptyMembersBox": true
        }
    }
}%%
classDiagram
    direction TB
    accTitle: Recognized Entities Vocabulary
    accDescr {
        Mermaid representation of the Vocabulary. See the non-visual structure of the diagram
        on ./vocabulary.mmd: classes on the diagram correspond to the RDFS classes; connecting
        lines with labels represent properties with ranges and domains defined in this vocabulary,
        and entries in the class boxes correspond to properties on a class that have external
        resources or datatypes as values.
    }
    class RecognizedEntity {
        registration : URL
    }
    class RecognizedAction {
        action : string
        recognizedBy : URL
        validFrom : dateTime
        validUntil : dateTime
    }
    class RecognizedEntityCredential {
        legalName
        image : URL
        url : URL
        sameAs : URL
        description
        digestMultibase
        validFrom : dateTime
        validUntil : dateTime
        name
        issuer
        credentialSubject
    }
    class RecognizedIssuer {}
    class CredentialValidator {}
    class ExternalEntityList {}


    RecognizedEntityCredential --|> VerifiableCredential : subClassOf

    RecognizedEntity --> RecognizedAction : recognizedTo
    RecognizedEntity --> ExternalEntityList : recognizedIn
    RecognizedEntity --> RecognizedEntityCredential : recognizedIn
    RecognizedAction --> CredentialValidator : credentialValidator
    RecognizedIssuer --> ExternalEntityList : recognizedIn
    RecognizedIssuer --> RecognizedEntityCredential : recognizedIn

