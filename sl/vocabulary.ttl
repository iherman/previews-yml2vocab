@prefix cs: <https://www.w3.org/ns/credentials/status#> .
@prefix cred: <https://w3.org/2018/credentials#> .
@prefix sec: <https://w3id.org/security#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix schema: <http://schema.org/> .
@prefix jsonld: <http://www.w3.org/ns/json-ld#> .

# Ontology definition
cs: a owl:Ontology ;
    dc:title """Bitstring Status List Vocabulary v1.1"""@en ;
    dc:description """RDFS [[RDF-SCHEMA]] vocabulary used by the [[[VC-BITSTRING-STATUS-LIST-1.1]]] [[VC-BITSTRING-STATUS-LIST-1.1]]"""^^rdf:HTML ;
    rdfs:seeAlso <https://www.w3.org/TR/vc-bitstring-status-list-1.1/> ;
    dc:date "2026-11-04"^^xsd:date ;
.

# Property definitions
cs:statusPurpose a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusList cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:range xsd:string ;
    rdfs:label "The purpose of the status list" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusPurpose>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:statusListIndex a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "The position of the entry in the status list" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusListIndex>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:statusListCredential a rdf:Property, owl:ObjectProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:range cs:BitstringStatusListCredential ;
    rdfs:label "The location of the status list credential" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusListCredential>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:encodedList a rdf:Property ;
    rdfs:domain cs:BitstringStatusList ;
    rdfs:range sec:multibase ;
    rdfs:label "The encoded status list bitstring" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#encodedList>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:ttl a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain cs:BitstringStatusList ;
    rdfs:range xsd:string ;
    rdfs:label "Time to live in milliseconds" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#ttl>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:statusSize a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "Bitstring entry size in bits" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusSize>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:statusMessage a rdf:Property, owl:ObjectProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:range cs:BitstringStatusMessage ;
    rdfs:label "Status message" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusMessage>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:status a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain cs:BitstringStatusMessage ;
    rdfs:range xsd:string ;
    rdfs:label "Hexadecimal value of a status message" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#status>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:message a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain cs:BitstringStatusMessage ;
    rdfs:range xsd:string ;
    rdfs:label "Human-readable message of a status value" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#message>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:statusReference a rdf:Property, owl:ObjectProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (cs:BitstringStatusListEntry cs:TerseBitstringStatusListEntry) ] ;
    rdfs:label "Reference documentation for status messages" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusReference>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:terseStatusListBaseUrl a rdf:Property, owl:ObjectProperty ;
    rdfs:domain cs:TerseBitstringStatusListEntry ;
    rdfs:label "Terse status list base url" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#tersebitstringstatuslistentry>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:terseStatusListIndex a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain cs:TerseBitstringStatusListEntry ;
    rdfs:range xsd:unsignedInt ;
    rdfs:label "Terse status list index" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#tersebitstringstatuslistentry>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

# Class definitions
cs:BitstringStatusList a rdfs:Class ;
    rdfs:label "Bitstring status list class" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#bitstringstatuslist>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:BitstringStatusListEntry a rdfs:Class ;
    rdfs:subClassOf cred:CredentialStatus ;
    rdfs:label "Bitstring status list entry class" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#bitstringstatuslistentry>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:BitstringStatusListCredential a rdfs:Class ;
    rdfs:subClassOf cred:VerifiableCredential ;
    rdfs:label "Bitstring status list credential class" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#bitstringstatuslistcredential>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:BitstringStatusMessage a rdfs:Class ;
    rdfs:label "Bitstring status message class" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#statusMessage>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.

cs:TerseBitstringStatusListEntry a rdfs:Class ;
    rdfs:subClassOf cred:CredentialStatus ;
    rdfs:label "Terse bitstring status list entry" ;
    rdfs:isDefinedBy <https://www.w3.org/TR/vc-bitstring-status-list-1.1/#tersebitstringstatuslistentry>, <https://www.w3.org/ns/credentials/status#> ;
    vs:term_status "stable" ;
.



# Context files and their mentions
<https://www.w3.org/ns/credentials/status/v1.1r1> a jsonld:Context ;
    schema:mentions
        cs:BitstringStatusList,
        cs:BitstringStatusListCredential,
        cs:BitstringStatusListEntry,
        cs:BitstringStatusMessage,
        cs:TerseBitstringStatusListEntry,
        cs:encodedList,
        cs:message,
        cs:status,
        cs:statusListCredential,
        cs:statusListIndex,
        cs:statusMessage,
        cs:statusPurpose,
        cs:statusReference,
        cs:statusSize,
        cs:terseStatusListBaseUrl,
        cs:terseStatusListIndex,
        cs:ttl ;
.

<https://www.w3.org/ns/credentials/v2.1> a jsonld:Context ;
    schema:mentions
        cs:BitstringStatusList,
        cs:BitstringStatusListCredential,
        cs:BitstringStatusListEntry,
        cs:BitstringStatusMessage,
        cs:TerseBitstringStatusListEntry,
        cs:encodedList,
        cs:message,
        cs:status,
        cs:statusListCredential,
        cs:statusListIndex,
        cs:statusMessage,
        cs:statusPurpose,
        cs:statusReference,
        cs:statusSize,
        cs:terseStatusListBaseUrl,
        cs:terseStatusListIndex,
        cs:ttl ;
.

